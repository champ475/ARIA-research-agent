# Staging (OPS-01): production-like, never production data or credentials.
# Copy to .env.staging and fill in. Everything not listed here is as in
# .env.example. Used by `docker compose --profile staging up`.
APP_ENV=staging

# Its own database: a Neon branch of production with PII scrubbed, or the
# compose `db-staging` container (then seed it: python scripts/seed_staging.py).
DATABASE_URL=postgresql://aria:aria@db-staging:5432/aria_staging
# Refuse to start if this ever points at production:
PROD_DATABASE_HOSTS=ep-prod-xxxx-pooler.region.aws.neon.tech,ep-prod-xxxx.region.aws.neon.tech

# Its own secrets — never production's.
SECRET_KEY=generate-a-different-32+-character-secret-for-staging
APP_BASE_URL=https://staging.aria.example.com

# A second bot from @BotFather (e.g. aria_staging_bot) so staging alerts never
# reach real users' Telegram chats.
TELEGRAM_BOT_TOKEN=staging_bot_token
TELEGRAM_BOT_USERNAME=aria_staging_bot

# Separate, low-quota LLM keys (or a local model) so staging can't spend production's budget.
GROQ_API_KEY_1=staging_groq_key
GEMINI_API_KEY=staging_gemini_key

# Email goes to a test inbox (or MAIL_BACKEND=console to only log links).
MAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aria.staging.test@gmail.com
SMTP_PASSWORD=app-password
SMTP_FROM=aria.staging.test@gmail.com
