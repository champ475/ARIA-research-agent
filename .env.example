# ── Groq API Keys (power the free trial everyone gets before adding their own
# ── key in-app under Settings — add multiple for rotation, all free at
# ── console.groq.com). Not required if you don't want to offer a trial —
# ── users can still bring their own key with none of these set.
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here

# ── Google Gemini (trial fallback — free at aistudio.google.com/apikey) ──────
GEMINI_API_KEY=your_gemini_key_here

# ── Optional: force provider (groq | gemini) ──────────────────────────────────
# PREFERRED_PROVIDER=groq

# ── Required: encrypts users' own LLM API keys before storing them (Settings
# ── tab, bring-your-own-key) — any random string, set once. Changing it later
# ── makes previously stored keys undecryptable.
SECRET_KEY=change_this_to_any_random_string

# ── Postgres (Neon — free tier, shared by the app and the GH Actions alert checker) ─
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Telegram (alert notifications — one bot serves every user, each user links
# ── their own chat in-app under Settings, no per-user bot setup needed) ──────
# ── Create a bot via @BotFather (message it, send /newbot), copy the token
# ── and the username it gives you (without the @).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# ── Operations (all optional — defaults shown) ────────────────────────────────
# LOG_LEVEL=INFO                    # JSON logs to stderr (utils/logging_setup.py)
# CHAT_CONCURRENCY=8                # chat turns processed at once, server-wide (one per user)
# QUEUE_MAX_SIZE=100                # Gradio queue length before new requests are refused
# DB_POOL_MAX=20                    # Postgres connections in the app's pool
# DB_POOL_ACQUIRE_TIMEOUT=10        # seconds to wait for a free DB connection
# ALERT_MAX_DELIVERY_ATTEMPTS=5     # Telegram retries before an alert goes to the in-app inbox
# BYO_ALLOW_PRIVATE_HOSTS=false     # true ONLY for self-hosting with a local model server (e.g. Ollama);
#                                   # lets users' BYO base URL reach private/internal hosts

# ── Tests only: a throwaway Postgres for tests/integration (never your real DB).
# ── Without it, the suite starts a temporary Postgres in Docker, or skips.
# TEST_DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_test

# ── Local LLM fallback (optional) ─────────────────────────────────────────────
# Any OpenAI-compatible server you run (llama.cpp llama-server, Ollama, LM Studio).
# Tried last, after Groq/Gemini (or a user's BYO key) fail. Empty = disabled.
# Operator config: may point at localhost (not subject to the BYO public-https rule).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-fast
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MAX_TOKENS=1024          # cap output: a CPU model runs ~5 tok/s
LOCAL_LLM_TIMEOUT_SECONDS=300

# ── Schema migrations (ARCH-01) ───────────────────────────────────────────────
# The app never creates/alters tables at startup; it refuses to start if the DB
# isn't at the latest migration. Apply migrations with:
#     python scripts/migrate.py
# (the Docker image does this before starting the app). Set this to true only
# for a single-instance deployment that should migrate itself on boot.
RUN_MIGRATIONS_ON_START=false
