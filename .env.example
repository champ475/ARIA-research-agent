# ── Groq API Keys (add multiple for rotation — all free at console.groq.com) ──
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here

# ── Google Gemini (fallback — free at aistudio.google.com/apikey) ─────────────
GEMINI_API_KEY=your_gemini_key_here

# ── Optional: force provider (groq | gemini) ──────────────────────────────────
# PREFERRED_PROVIDER=groq

# ── Postgres (Neon — free tier, shared by the app and the GH Actions alert checker) ─
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Telegram (alert notifications — create a bot via @BotFather, get your chat id via @userinfobot) ─
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Optional: route requests through the LangGraph research engine instead of ─
# ── the legacy keyword-routed orchestrator (see RFC_AGENTIC_RESEARCH_GRAPH.md) ─
# USE_LANGGRAPH_ORCHESTRATOR=false
