# ═════════════════════════════════════════════════════════════════════════════
# ARIA settings: the template for your local `.env`
#
#   1. Copy it:   cp .env.example .env              (PowerShell: Copy-Item .env.example .env)
#   2. Fill in every line marked  [REQUIRED].  Lines marked [RECOMMENDED] make
#      a feature work (alerts, email, background jobs). Everything that is
#      commented out (#) is optional and shows its default.
#   3. Check it:  python -c "import config; config.check_boot(); print('config OK')"
#
# Every setting is typed and validated at start-up (config.py, ARCH-03): a bad
# value stops the app with one list of everything that needs fixing.
# `.env` is git-ignored. Never commit it, and never paste its values in chat.
# Staging and production list their own differences in .env.staging.example
# and .env.prod.example (see docs/ENVIRONMENTS.md).
# ═════════════════════════════════════════════════════════════════════════════


# ── 1. Environment ───────────────────────────────────────────────────────────
# dev | test | staging | prod.  Keep `dev` on your own machine.
#   dev:  emails are printed to the log, background jobs run inside the app,
#         cookies work over plain http://localhost.
#   prod: refuses to start without SMTP email, an https:// APP_BASE_URL and
#         ≥1 LLM key, and needs `python worker.py` running next to the app.
#         Use it only on a real server behind https.
APP_ENV=dev


# ── 2. Database: Neon Postgres  [REQUIRED] ───────────────────────────────────
# Neon console → your project → Dashboard → "Connect" button:
#   • Branch: the branch this machine should use (see docs/ENVIRONMENTS.md;
#     a `dev` branch keeps local experiments away from `main`'s data).
#   • Database: neondb   Role: neondb_owner
#   • "Connection pooling" ON  → copy the string → DATABASE_URL
#     (host contains "-pooler").
#   • "Connection pooling" OFF → copy the string → JOBS_DATABASE_URL
#     (same host without "-pooler"). Background-job locks need a direct
#     connection: PgBouncer in transaction mode drops session locks.
# Keep `?sslmode=require` at the end. If the password has @ : / or #, use
# the string exactly as Neon shows it (it is already URL-encoded).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
JOBS_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# OPS-01 guard: the hostnames of the PRODUCTION branch (Neon `main`), pooled
# and direct, comma-separated (host only: no user, password or path). A dev or
# staging process refuses to start against them. Set it when this machine uses
# a dev branch; leave it empty if `main` is the only database you have.
# PROD_DATABASE_HOSTS=ep-main-xxxx-pooler.REGION.aws.neon.tech,ep-main-xxxx.REGION.aws.neon.tech

# Run the schema migrations yourself (the app never creates tables):
#     python scripts/migrate.py --check    # what's pending (changes nothing)
#     python scripts/migrate.py            # upgrade to the latest revision
# true = the app migrates itself on boot (single-instance deployments only).
RUN_MIGRATIONS_ON_START=false


# ── 3. Secret key  [REQUIRED] ────────────────────────────────────────────────
# Encrypts users' own LLM API keys (Settings tab) and keys log pseudonyms.
# ≥ 32 random characters; the app refuses to start with this placeholder.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it makes already-stored BYO keys unreadable. To rotate safely: put
# the old value in SECRET_KEY_PREVIOUS, set a new SECRET_KEY, run
# `python scripts/rotate_secret_key.py`, then empty SECRET_KEY_PREVIOUS.
# Save a copy in your password manager (docs/RUNBOOK.md → Secret escrow).
SECRET_KEY=change_this_to_any_random_string
SECRET_KEY_PREVIOUS=


# ── 4. LLM keys: the free trial  [REQUIRED for answers] ──────────────────────
# Groq: https://console.groq.com/keys (free; up to 5 keys, used round-robin
# to spread the per-key rate limit). Leave unused slots empty.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# Gemini fallback: https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=
# Which provider to try first (groq | gemini).
# PREFERRED_PROVIDER=groq
# Users can always add their own key under Settings, with none of these set.

# Models (LLM-08). Each node walks an ordered "provider:model" list; a retired
# model is detected (startup probe, or its first 404) and skipped. Defaults:
#   fast       groq:openai/gpt-oss-20b, gemini:gemini-3.5-flash-lite, gemini:gemini-3.6-flash
#   synthesis  groq:openai/gpt-oss-120b, gemini:gemini-3.6-flash, groq:openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# ARIA_MODELS_FAST=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite
# ARIA_MODELS_SYNTHESIS=groq:openai/gpt-oss-120b,gemini:gemini-3.6-flash
# ARIA_MODEL_PLANNER=...           # per node: query_analyzer, planner, reflection, verification,
#                                  # communication, suggestions, summary, extract


# ── 5. Telegram: price alerts  [RECOMMENDED] ─────────────────────────────────
# One bot serves every user; each user links their own chat in-app (Settings).
# Telegram → @BotFather → /newbot → copy the token and the username (no @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Ops alerts (OBS-04) are sent to YOUR chat. Find your chat id: send any
# message to your bot, then open
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# and copy "chat":{"id": ...}.
OPERATOR_TELEGRAM_CHAT_ID=
# ALERT_MAX_DELIVERY_ATTEMPTS=5   # Telegram retries before an alert goes to the in-app inbox


# ── 6. Email: verification, password reset, ops alerts (SEC-06) ──────────────
# dev: `console` prints the email (and its link) to the app log. Nothing is sent.
MAIL_BACKEND=console
# To send real mail with Gmail (needs 2-Step Verification on the account):
#   https://myaccount.google.com/apppasswords → create "ARIA" → 16-char password.
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop        # the app password, without spaces
# SMTP_FROM=you@gmail.com
# SMTP_STARTTLS=true
# OPERATOR_EMAIL=you@gmail.com          # ops alerts by email too (needs smtp)
# Links in emails point here (must be https:// in staging/prod):
# APP_BASE_URL=http://localhost:7860
# REQUIRE_EMAIL_VERIFICATION=           # unset = required everywhere except dev/test
# FRAME_ANCESTORS='none'                # CSP frame-ancestors; set a host (e.g. https://huggingface.co) to embed
# HSTS_ENABLED=                         # unset = on except dev/test (serve https only)


# ── 7. Background jobs (REL-05) ──────────────────────────────────────────────
# Alerts, Telegram polling, purges, nightly fundamentals/MF refreshes, the
# data canary and the ops watchdog. Unset = inside the app in dev, otherwise
# run `python worker.py` next to the app.
# RUN_JOBS_IN_APP=


# ── 8. Local LLM fallback (optional) ─────────────────────────────────────────
# Any OpenAI-compatible server (llama.cpp from ..\local-llm: .\start-server.ps1,
# Ollama, LM Studio). Tried last, after Groq/Gemini (or a BYO key) fail.
# Empty = disabled. While set, a turn may take up to 10 minutes.
LOCAL_LLM_BASE_URL=
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=local-fast
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_MAX_TOKENS=1024          # cap output: a CPU model runs ~5 tok/s
# LOCAL_LLM_TIMEOUT_SECONDS=300


# ── 9. Tracing: LangSmith (optional, OBS-02) ─────────────────────────────────
# Every turn always writes a `turns` row (error IDs users see are its prefix:
# `python scripts/find_turn.py <error_id>`). For LangSmith traces with
# redacted inputs, create a key at https://smith.langchain.com and set:
# ARIA_TRACING=langsmith
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=aria          # the project's exact name in LangSmith. An "agent" there gets one
#                                 # project per environment, e.g. my-agent-local / -development /
#                                 # -staging / -production. LANGSMITH_AGENT_ID/_ENVIRONMENT are not read.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your account is in the EU region
# Do NOT set LANGSMITH_TRACING=true or LANGCHAIN_TRACING_V2=true: they make
# LangChain auto-trace full, UNREDACTED graph state (chat history, financial
# profiles) to LangSmith.


# ── 10. Monitoring (OBS-03 / OBS-04) ─────────────────────────────────────────
# Bearer token for GET /metrics (required outside dev/test; the route is off
# without it there). Generate like SECRET_KEY.
# METRICS_TOKEN=
# ALERT_REMINDER_MINUTES=60       # re-page while an alert keeps firing
# DB_SIZE_LIMIT_MB=512            # your Neon plan's storage, for the "DB > 80%" alert (free: 512)
# SLO_AVAILABILITY=0.995
# SLO_EQUITY_P95_TTFT_SECONDS=15
# BACKUP_DIR=backups              # where scripts/backup_db.py writes dumps; copy them off this machine


# ── 11. Web server and abuse controls (SEC-04 / SEC-05) ──────────────────────
# HOST=0.0.0.0
# PORT=7860
# COOKIE_SECURE=                  # unset = Secure cookies everywhere except dev/test
# TRUSTED_PROXIES=10.0.0.0/8      # only these peers may set X-Forwarded-For
# Optional Cloudflare Turnstile CAPTCHA, shown after 3 failed logins from one
# IP in an hour (https://dash.cloudflare.com → Turnstile → Add widget):
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=


# ── 12. Tuning (defaults shown; change only with a reason) ───────────────────
# LOG_LEVEL=INFO                  # JSON logs to stderr
# CHAT_CONCURRENCY=8              # chat turns processed at once, server-wide (one per user)
# TRIAL_DAILY_LIMIT=5             # free messages/day per user on your keys
# TRIAL_DAILY_TOKENS=60000        # free-trial LLM tokens/day per user (0 = no cap)
# TURNS_PER_MINUTE=10             # chat turns per user per minute
# MAX_ENTITIES_PER_TURN=5         # companies researched in one question
# QUEUE_MAX_SIZE=100              # Gradio queue length before new requests are refused
# DB_POOL_MAX=20                  # Postgres connections in the app's pool
# DB_POOL_MIN=2
# DB_POOL_ACQUIRE_TIMEOUT=10      # seconds to wait for a free connection
# DB_STATEMENT_TIMEOUT_MS=5000    # per-statement cap (0 = off). Not sent to Neon's -pooler host,
#                                 # which refuses it: there, run once in the Neon SQL editor
#                                 #   ALTER ROLE neondb_owner SET statement_timeout = '5s';
# BYO_ALLOW_PRIVATE_HOSTS=false   # true ONLY when self-hosting with a local model server
# LLM_TIMEOUT_SECONDS=30          # cloud LLM, non-streaming call
# LLM_STREAM_TIMEOUT_SECONDS=15   # max gap between streamed chunks (also first token)
# YF_TIMEOUT_SECONDS=10           # one yfinance call
# TOOL_TIMEOUT_SECONDS=25         # one research tool call
# TURN_DEADLINE_SECONDS=90        # whole turn (600 when LOCAL_LLM_BASE_URL is set)
# BREAKER_FAILURES=5              # failures within the window that open a source's breaker
# BREAKER_WINDOW_SECONDS=60
# BREAKER_COOLDOWN_SECONDS=30


# ── Tests only ───────────────────────────────────────────────────────────────
# A throwaway Postgres for tests/integration (never your real database).
# Without it, the suite starts a temporary Postgres in Docker, or skips.
# TEST_DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_test

# ── Phase 3 (all optional) ───────────────────────────────────────────────────
# VERIFICATION_STRONG_JUDGE=false       # judge complex turns with the synthesis-class model (LLM-13)
# WATCHLIST_WORKERS=8                   # parallel quote fetches for the watchlist table (REL-07)
# WATCHLIST_BUDGET_SECONDS=15           # a symbol that hasn't answered by then shows a dash
# WATCHLIST_ROW_TTL_SECONDS=60          # a fetched row is reused this long
# ARIA_FAULTS_FILE=                     # load/chaos tests only: JSON the fake LLM and fake data read (TEST-06)
