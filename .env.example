# ── Environment (dev | test | staging | prod) ─────────────────────────────────
# Every setting below is typed and validated at start-up (config.py, ARCH-03):
# a bad value stops the app with one list of everything that needs fixing.
APP_ENV=dev

# ── Groq API Keys (power the free trial everyone gets before adding their own
# ── key in-app under Settings — add multiple for rotation, all free at
# ── console.groq.com). Not required if you don't want to offer a trial —
# ── users can still bring their own key with none of these set.
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here

# ── Google Gemini (trial fallback — free at aistudio.google.com/apikey) ──────
GEMINI_API_KEY=your_gemini_key_here

# ── Optional: force provider (groq | gemini) ──────────────────────────────────
# PREFERRED_PROVIDER=groq

# ── Required: encrypts users' own LLM API keys before storing them (Settings
# ── tab) and keys log pseudonyms. At least 32 random characters — the app
# ── refuses to start with this placeholder. Generate one with:
# ──   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ── To rotate: move the old value to SECRET_KEY_PREVIOUS, set a new SECRET_KEY,
# ── run `python scripts/rotate_secret_key.py`, then clear SECRET_KEY_PREVIOUS.
SECRET_KEY=change_this_to_any_random_string
# SECRET_KEY_PREVIOUS=

# ── Postgres (Neon — free tier, shared by the app and the GH Actions alert checker) ─
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Telegram (alert notifications — one bot serves every user, each user links
# ── their own chat in-app under Settings, no per-user bot setup needed) ──────
# ── Create a bot via @BotFather (message it, send /newbot), copy the token
# ── and the username it gives you (without the @).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# ── Operations (all optional — defaults shown) ────────────────────────────────
# LOG_LEVEL=INFO                    # JSON logs to stderr (utils/logging_setup.py)
# CHAT_CONCURRENCY=8                # chat turns processed at once, server-wide (one per user)
# TRIAL_DAILY_LIMIT=5               # free messages/day per user on the operator's keys
# QUEUE_MAX_SIZE=100                # Gradio queue length before new requests are refused
# DB_POOL_MAX=20                    # Postgres connections in the app's pool
# DB_POOL_ACQUIRE_TIMEOUT=10        # seconds to wait for a free DB connection
# DB_POOL_MIN=2                     # connections kept open
# DB_STATEMENT_TIMEOUT_MS=5000      # server cancels any one statement after this (0 = off). Neon: use the
#                                   # -pooler host; if a pooler rejects startup options, set 0 here and
#                                   # ALTER ROLE <app_user> SET statement_timeout = '5s' instead.
# ALERT_MAX_DELIVERY_ATTEMPTS=5     # Telegram retries before an alert goes to the in-app inbox
# BYO_ALLOW_PRIVATE_HOSTS=false     # true ONLY for self-hosting with a local model server (e.g. Ollama);
#                                   # lets users' BYO base URL reach private/internal hosts

# ── Tests only: a throwaway Postgres for tests/integration (never your real DB).
# ── Without it, the suite starts a temporary Postgres in Docker, or skips.
# TEST_DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_test

# ── Local LLM fallback (optional) ─────────────────────────────────────────────
# Any OpenAI-compatible server you run (llama.cpp llama-server, Ollama, LM Studio).
# Tried last, after Groq/Gemini (or a user's BYO key) fail. Empty = disabled.
# Operator config: may point at localhost (not subject to the BYO public-https rule).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-fast
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MAX_TOKENS=1024          # cap output: a CPU model runs ~5 tok/s
LOCAL_LLM_TIMEOUT_SECONDS=300

# ── Schema migrations (ARCH-01) ───────────────────────────────────────────────
# The app never creates/alters tables at startup; it refuses to start if the DB
# isn't at the latest migration. Apply migrations with:
#     python scripts/migrate.py
# (the Docker image does this before starting the app). Set this to true only
# for a single-instance deployment that should migrate itself on boot.
RUN_MIGRATIONS_ON_START=false

# ── Timeouts, breakers and the turn deadline (REL-02) ─────────────────────────
# LLM_TIMEOUT_SECONDS=30          # cloud LLM, non-streaming call
# LLM_STREAM_TIMEOUT_SECONDS=15   # max gap between streamed chunks (also first token)
# YF_TIMEOUT_SECONDS=10           # one yfinance call
# TOOL_TIMEOUT_SECONDS=25         # one research tool call
# TURN_DEADLINE_SECONDS=90        # whole turn (600 when LOCAL_LLM_BASE_URL is set)
# BREAKER_FAILURES=5              # failures within the window that open a source's breaker
# BREAKER_WINDOW_SECONDS=60
# BREAKER_COOLDOWN_SECONDS=30

# ── Per-turn tracing (OBS-02) ─────────────────────────────────────────────────
# Every turn always writes a row to the `turns` table (error IDs shown to users
# are its id prefix: `python scripts/find_turn.py <error_id>`). Optional
# LangSmith traces, with redacted inputs:
# ARIA_TRACING=langsmith
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=aria
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region, if your account is there
# Do NOT set LANGSMITH_TRACING=true / LANGCHAIN_TRACING_V2=true: that auto-traces full,
# unredacted graph state (chat history, financial profiles).

# ── Web server and sessions (SEC-04) ──────────────────────────────────────────
# `python app.py` serves FastAPI (login/signup/logout pages, HttpOnly cookie
# sessions) with the Gradio UI mounted at /.
# HOST=0.0.0.0
# PORT=7860
# COOKIE_SECURE=            # unset = Secure cookies everywhere except APP_ENV=dev/test

# ── Email: verification and password reset (SEC-06) ───────────────────────────
# APP_BASE_URL=https://aria.example.com   # links in emails point here (http://localhost:7860 in dev)
# MAIL_BACKEND=console                    # dev/test: emails are written to the log
# Free, no-domain option — a Gmail account with an app password
# (Google Account → Security → 2-Step Verification → App passwords):
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# REQUIRE_EMAIL_VERIFICATION=             # unset = required everywhere except APP_ENV=dev/test
