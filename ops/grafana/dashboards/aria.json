{
  "uid": "aria-overview",
  "title": "ARIA — production overview",
  "tags": [
    "aria"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Turns by intent (per min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aria-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aria-prometheus"
          },
          "expr": "sum by (intent) (rate(aria_turns_total[5m])) * 60",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (SLO 99.5%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aria-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aria-prometheus"
          },
          "expr": "sum(rate(aria_turns_total{status=~\"error|llm_unavailable\"}[10m])) / clamp_min(sum(rate(aria_turns_total[10m])), 1e-9)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Time to first output p50 / p95 (equity SLO ≤ 15 s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aria-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "aria-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aria_turn_ttft_seconds_bucket[5m])))",
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "aria-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aria_turn_ttft_seconds_bucket[5m])))",
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "aria-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aria_turn_ttft_seconds_bucket{intent=\"equity\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
