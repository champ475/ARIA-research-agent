# Production (OPS-01). Real values live ONLY in production's secret store
# (the host's secrets / GitHub environment "production"), never in a file in
# the repo or on a developer machine. This lists what production must set;
# everything else is as in .env.example.
APP_ENV=prod

DATABASE_URL=postgresql://user:pass@ep-prod-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
JOBS_DATABASE_URL=postgresql://user:pass@ep-prod-xxxx.region.aws.neon.tech/neondb?sslmode=require

SECRET_KEY=from-the-secret-store
APP_BASE_URL=https://aria.example.com

TELEGRAM_BOT_TOKEN=from-the-secret-store
TELEGRAM_BOT_USERNAME=aria_bot

GROQ_API_KEY_1=from-the-secret-store
GEMINI_API_KEY=from-the-secret-store

MAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=from-the-secret-store
SMTP_PASSWORD=from-the-secret-store
SMTP_FROM=from-the-secret-store

RUN_JOBS_IN_APP=false   # run worker.py next to the app
